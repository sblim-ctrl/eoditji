{
  "name": "eoditji",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "deno test --allow-env supabase/functions/_shared eval/common_test.ts",
    "rls-check": "node --env-file=.env scripts/rls-check.ts",
    "functions-check": "node --env-file=.env scripts/functions-check.ts",
    "spike": "node --env-file=.env eval/spike-box.ts",
    "eval:recognize": "deno run -A --env-file=.env eval/run-recognize.ts",
    "eval:search": "deno run -A --env-file=.env eval/run-search.ts",
    "eval:box": "deno run -A --env-file=.env eval/box-hit.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.65.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
